{
  "name": "suno-downloader-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/write-seo.mjs",
    "start": "node scripts/start.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "yarn test:i18n && yarn build && yarn test:seo && yarn test:hydration && node --test ../backend/server.test.js && yarn test:unit",
    "test:hydration": "node scripts/check-hydration.mjs",
    "test:seo": "node scripts/check-seo.mjs",
    "test:unit": "node --experimental-strip-types --test src/features/downloader/*.test.ts",
    "test:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "mp4box": "2.5.0",
    "opus-decoder": "0.7.12",
    "posthog-js": "^1.438.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/node": "^16.18.126",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.18.20",
    "jsdom": "26.1.0",
    "patch-package": "8.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^4.5.14",
    "vite-prerender-plugin": "0.4.0"
  },
  "engines": {
    "node": ">=16.14"
  }
}
